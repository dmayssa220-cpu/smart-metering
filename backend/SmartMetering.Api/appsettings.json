{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=database;Port=5432;Database=smartmetering;Username=sm_user;Password=sm_password"
  },
  "AiService": {
